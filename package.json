{
  "name": "rocky035-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/check-secrets.mjs",
    "avisos:exportar": "node scripts/exportar-avisos.mjs",
    "seed:drop4": "node scripts/seed-drop4.mjs",
    "images:optimize": "node scripts/optimizar-imagenes.mjs",
    "check": "npm run test:run && npm run lint && npm run lint:css && npm run build && npm run security:check",
    "dev:client": "vite",
    "dev:server": "PORT=3001 node --watch server/index.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\""
  },
  "description": "Tienda web de ROCKY 035: React + Vite y un BFF Express preparado para Shopify.",
  "main": "server/index.mjs",
  "license": "UNLICENSED"
}

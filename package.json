{
  "name": "rocky035-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "vite": "^8.2.1",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "vite build && node scripts/precompress.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/check-secrets.mjs",
    "budget:check": "node scripts/check-budget.mjs",
    "avisos:exportar": "node scripts/exportar-avisos.mjs",
    "avisos:enviar": "node scripts/enviar-avisos.mjs",
    "seed:drop4": "node scripts/seed-drop4.mjs",
    "images:optimize": "node scripts/optimizar-imagenes.mjs",
    "release:preparar": "node scripts/release/preparar.mjs",
    "release:promover": "node scripts/release/promover.mjs promover",
    "release:revertir": "node scripts/release/promover.mjs revertir",
    "check": "npm run test:run && npm run lint && npm run lint:css && npm run build && npm run budget:check && npm run security:check",
    "dev:client": "vite",
    "dev:server": "PORT=3001 node --watch server/index.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\"",
    "taller:clave": "node scripts/taller-clave.mjs"
  },
  "description": "Tienda web de ROCKY 035: React + Vite y un BFF Express preparado para Shopify.",
  "main": "server/index.mjs",
  "license": "UNLICENSED"
}

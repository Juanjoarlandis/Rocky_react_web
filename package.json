{
  "name": "rocky_react",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "security:check": "node scripts/check-secrets.mjs",
    "avisos:exportar": "node scripts/exportar-avisos.mjs",
    "check": "npm run test:run && npm run build && npm run security:check",
    "dev:client": "vite",
    "dev:server": "node --watch server.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:client\" \"npm run dev:server\""
  },
  "description": "Tienda web de ROCKY 035: React + Vite y un BFF Express preparado para Shopify.",
  "main": "server.mjs",
  "keywords": [],
  "author": "",
  "license": "ISC"
}

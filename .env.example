# Aplicación y origen público
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
API_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0

# Puerta privada temporal. La contraseña vive sólo en el entorno del servidor.
SITE_ACCESS_ENABLED=false
SITE_ACCESS_PASSWORD=

# Rocky IA (opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-20b:free
CHAT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_MS=600000
CHAT_GLOBAL_DAILY_MAX=45
CHAT_MAX_CONCURRENT=4
CHAT_TIMEOUT_MS=20000

# Estado cifrado. Genera una clave distinta para cada entorno.
APP_ENCRYPTION_KEY=
STATE_STORE_PATH=.data/rocky-state.enc

# Storefront API y carrito
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_TOKEN_TYPE=private
SHOPIFY_EXPOSE_QUANTITY=false
SHOPIFY_CHECKOUT_HOSTS=
SHOPIFY_RATE_LIMIT_MAX=120
SHOPIFY_RATE_LIMIT_WINDOW_MS=60000

# Dev Dashboard / Admin API / firma de webhooks (opcionales)
# La acreditación Crew requiere el scope Admin read_orders y la suscripción orders/paid.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_TOPICS=app/uninstalled,app/scopes_update,orders/paid

# Customer Account API (opcional; necesita PUBLIC_ORIGIN HTTPS)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SCOPES=openid email customer-account-api:full

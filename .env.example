# Aplicación y origen público
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
API_ALLOWED_ORIGINS=http://localhost:3000
# Número exacto de proxies delante del servidor. En producción es obligatorio
# (>=1; con Cloudflare, 1): con 0 todos los usuarios compartirían la IP del proxy.
TRUST_PROXY_HOPS=0

# Puerta privada temporal. La contraseña vive sólo en el entorno del servidor.
SITE_ACCESS_ENABLED=false
SITE_ACCESS_PASSWORD=

# Rocky IA (opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-20b:free
CHAT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_MS=600000
CHAT_GLOBAL_DAILY_MAX=45
CHAT_MAX_CONCURRENT=4
CHAT_TIMEOUT_MS=20000

# Estado cifrado. Genera una clave distinta para cada entorno.
APP_ENCRYPTION_KEY=
STATE_STORE_PATH=.data/rocky-state.enc

# Storefront API y carrito
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_TOKEN_TYPE=private
SHOPIFY_EXPOSE_QUANTITY=false
SHOPIFY_CHECKOUT_HOSTS=
SHOPIFY_RATE_LIMIT_MAX=120
SHOPIFY_RATE_LIMIT_WINDOW_MS=60000

# Avisos de drop (POST /api/avisos): altas por IP y ventana. Apuntarse es cosa
# de una vez, así que con pocas altas por ventana sobra; el resto son bots.
AVISOS_RATE_LIMIT_MAX=6
AVISOS_RATE_LIMIT_WINDOW_MS=600000

# Envío de los avisos de drop. Sólo lo usa scripts/enviar-avisos.mjs: el servidor
# web nunca manda correos. Sin --apply el script es un simulacro; el envío real exige
# --apply, RESEND_API_KEY y AVISOS_FROM. AVISOS_FROM y AVISOS_REPLY_TO: «email» o
# «Nombre <email>» (si no, el script no arranca). AVISOS_BATCH_SIZE: máximo 100.
RESEND_API_KEY=
AVISOS_FROM=
AVISOS_REPLY_TO=
AVISOS_BATCH_SIZE=100

# Ranking de beats (POST /api/beats, «me mola» y reportes): altas y votos por IP y ventana.
BEATS_PUBLISH_RATE_LIMIT_MAX=6
BEATS_VOTE_RATE_LIMIT_MAX=60
BEATS_RATE_LIMIT_WINDOW_MS=600000
# Llave de moderación para DELETE /api/beats/:id (al menos 24 caracteres). Sin ella
# no se puede quitar ningún beat.
BEATS_ADMIN_TOKEN=

# Dev Dashboard / Admin API / firma de webhooks (opcionales)
# La acreditación Crew requiere el scope Admin read_orders y la suscripción orders/paid.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_TOPICS=app/uninstalled,app/scopes_update,orders/paid
# Token estático de Admin API. Sólo lo usa scripts/seed-drop4.mjs, como alternativa a
# client_credentials con SHOPIFY_CLIENT_ID y SHOPIFY_CLIENT_SECRET.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Drops y El Taller (opcionales; ver docs/ops/drops.md)
# Los drops se leen por la Admin API con SHOPIFY_CLIENT_ID/SECRET. El Taller (/taller)
# solo se enciende con las tres variables siguientes; genera las dos primeras con
# npm run taller:clave. La publicación es el canal Headless de la tienda.
SHOPIFY_HEADLESS_PUBLICATION_ID=
TALLER_PASSWORD_HASH=
TALLER_TOTP_SECRET=

# Customer Account API (opcional; necesita PUBLIC_ORIGIN HTTPS)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_SCOPES=openid email customer-account-api:full
